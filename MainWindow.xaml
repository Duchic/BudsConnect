<Window Style="{StaticResource AppWindow}" x:Class="BudsConnect.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BudsConnect" Width="440" Height="650" MinWidth="400" MinHeight="540" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="26,24,26,22">
  <TextBlock Text="{Binding Name}" FontSize="27" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <UniformGrid Columns="3" Margin="0,27,0,25">
   <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="&#xE95B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="21" Margin="0,0,0,14"/><TextBlock Text="Levé" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Text="{Binding Left}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,14"/><ProgressBar Value="{Binding LeftLevel, Mode=OneWay}" Maximum="100" AutomationProperties.Name="Baterie levého sluchátka"/></StackPanel></Border>
   <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="14" Margin="3,0"><StackPanel><TextBlock Text="&#xE95B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="21" Margin="0,0,0,14"/><TextBlock Text="Pravé" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Text="{Binding Right}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,14"/><ProgressBar Value="{Binding RightLevel, Mode=OneWay}" Maximum="100" AutomationProperties.Name="Baterie pravého sluchátka"/></StackPanel></Border>
   <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="&#xE850;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="21" Margin="0,0,0,14"/><TextBlock Text="Pouzdro" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Text="{Binding Case}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,14"/><ProgressBar Value="{Binding CaseLevel, Mode=OneWay}" Maximum="100" AutomationProperties.Name="Baterie pouzdra"/></StackPanel></Border>
  </UniformGrid>
  <TextBlock Text="Potlačení hluku" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <Border Background="{DynamicResource Soft}" CornerRadius="9" Padding="4"><UniformGrid Columns="2" IsEnabled="{Binding CanControlAnc}"><RadioButton Style="{StaticResource Segment}" GroupName="Anc" Content="Vypnuto" IsChecked="{Binding AncOff, Mode=OneWay}" Click="AncOff_Click"/><RadioButton Style="{StaticResource Segment}" GroupName="Anc" Content="Zapnuto" IsChecked="{Binding AncOn, Mode=OneWay}" Click="AncOn_Click"/></UniformGrid></Border>
  <TextBlock Text="{Binding AncHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
  <Grid Margin="0,18,0,9"><TextBlock Text="Hlasitost"/><TextBlock Text="{Binding VolumeText}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></Grid>
  <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding CanControlVolume}" AutomationProperties.Name="Hlasitost Galaxy Buds3"/>
  <TextBlock Text="{Binding VolumeHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
  <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="Nastavení" Click="Settings_Click" HorizontalAlignment="Left" Padding="10,6" Background="Transparent"/><TextBlock Grid.Column="1" Text="{Binding Updated}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></Border>
  <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Znovu připojit" Click="Reconnect_Click" FontSize="12" Padding="10,7"/><Button Content="Bluetooth ve Windows" Click="Bluetooth_Click" FontSize="12" Padding="10,7" Margin="8,0,0,0"/></StackPanel>
 </StackPanel>
 </ScrollViewer>
</Window>



