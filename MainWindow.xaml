<Window Style="{StaticResource AppWindow}" x:Class="BudsConnect.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BudsConnect" Width="440" Height="650" MinWidth="400" MinHeight="540" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
 <Grid>
 <ScrollViewer x:Name="ClassicView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel Margin="26,24,26,22">
  <TextBlock Text="{Binding Name}" FontSize="27" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <UniformGrid Columns="3" Margin="0,27,0,25">
   <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="&#xE95B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="21" Margin="0,0,0,14"/><TextBlock Text="{DynamicResource Loc_Left}" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Text="{Binding Left}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,14"/><ProgressBar Value="{Binding LeftLevel, Mode=OneWay}" Maximum="100" AutomationProperties.Name="{DynamicResource Loc_LeftBattery}"/></StackPanel></Border>
   <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="14" Margin="3,0"><StackPanel><TextBlock Text="&#xE95B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="21" Margin="0,0,0,14"/><TextBlock Text="{DynamicResource Loc_Right}" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Text="{Binding Right}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,14"/><ProgressBar Value="{Binding RightLevel, Mode=OneWay}" Maximum="100" AutomationProperties.Name="{DynamicResource Loc_RightBattery}"/></StackPanel></Border>
   <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="&#xE850;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Muted}" FontSize="21" Margin="0,0,0,14"/><TextBlock Text="{DynamicResource Loc_Case}" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Text="{Binding Case}" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,14"/><ProgressBar Value="{Binding CaseLevel, Mode=OneWay}" Maximum="100" AutomationProperties.Name="{DynamicResource Loc_CaseBattery}"/></StackPanel></Border>
  </UniformGrid>
  <TextBlock Text="{DynamicResource Loc_NoiseControl}" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <Border Background="{DynamicResource Soft}" CornerRadius="9" Padding="4"><UniformGrid Columns="2" IsEnabled="{Binding CanControlAnc}"><RadioButton Style="{StaticResource Segment}" GroupName="Anc" Content="{DynamicResource Loc_Off}" IsChecked="{Binding AncOff, Mode=OneWay}" Click="AncOff_Click"/><RadioButton Style="{StaticResource Segment}" GroupName="Anc" Content="{DynamicResource Loc_On}" IsChecked="{Binding AncOn, Mode=OneWay}" Click="AncOn_Click"/></UniformGrid></Border>
  <TextBlock Text="{Binding AncHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
  <Grid Margin="0,18,0,9"><TextBlock Text="{DynamicResource Loc_Volume}"/><TextBlock Text="{Binding VolumeText}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></Grid>
  <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding CanControlVolume}" AutomationProperties.Name="{DynamicResource Loc_BudsVolume}"/>
  <TextBlock Text="{Binding VolumeHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
  <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"/>
  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{DynamicResource Loc_Settings}" Click="Settings_Click" HorizontalAlignment="Left" Padding="10,6" Background="Transparent"/><TextBlock Grid.Column="1" Text="{Binding Updated}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></Border>
  <WrapPanel Margin="0,14,0,0"><Button Content="{DynamicResource Loc_Reconnect}" Click="Reconnect_Click" FontSize="12" Padding="10,7"/><Button Content="{DynamicResource Loc_WindowsBluetooth}" Click="Bluetooth_Click" FontSize="12" Padding="10,7" Margin="8,0,0,0"/><Button x:Name="MiniButton" Content="Mini" Click="Mini_Click" FontSize="12" Padding="10,7" Margin="8,0,0,0" ToolTip="{DynamicResource Loc_MiniHint}"/></WrapPanel>
 </StackPanel>
 </ScrollViewer>
 <ScrollViewer x:Name="MiniView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="18,16">
   <UniformGrid Columns="3" ToolTip="{Binding Updated}">
    <StackPanel ToolTip="{DynamicResource Loc_LeftBud}" AutomationProperties.Name="{DynamicResource Loc_LeftBud}">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Width="18" Height="24" Stretch="Uniform" Fill="{DynamicResource Muted}" Data="M 9,1 C 3,1 1,4 1,8 C 1,12 4,14 8,14 L 8,23 Q 8,25 11,25 Q 14,25 14,23 L 14,10 C 18,8 17,1 9,1 Z"/><TextBlock Text="{DynamicResource Loc_LeftShort}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <TextBlock x:Name="MiniLeft" Text="{Binding Left}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel ToolTip="{DynamicResource Loc_RightBud}" AutomationProperties.Name="{DynamicResource Loc_RightBud}">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Width="18" Height="24" Stretch="Uniform" Fill="{DynamicResource Muted}" Data="M 9,1 C 15,1 17,4 17,8 C 17,12 14,14 10,14 L 10,23 Q 10,25 7,25 Q 4,25 4,23 L 4,10 C 0,8 1,1 9,1 Z"/><TextBlock Text="{DynamicResource Loc_RightShort}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <TextBlock x:Name="MiniRight" Text="{Binding Right}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel ToolTip="{DynamicResource Loc_ChargingCase}" AutomationProperties.Name="{DynamicResource Loc_ChargingCase}">
     <Grid Width="28" Height="24" HorizontalAlignment="Center"><Border Height="20" BorderBrush="{DynamicResource Muted}" BorderThickness="2" CornerRadius="6"/><Border Height="1" Background="{DynamicResource Muted}" VerticalAlignment="Top" Margin="1,9,1,0"/><Ellipse Width="3" Height="3" Fill="{DynamicResource Muted}" Margin="0,9,0,0"/></Grid>
     <TextBlock x:Name="MiniCase" Text="{Binding Case}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0"/>
    </StackPanel>
   </UniformGrid>
   <Grid Margin="0,17,0,10"><TextBlock Text="ANC" VerticalAlignment="Center" FontSize="12"/><Button x:Name="MiniAnc" Style="{StaticResource AncSwitch}" HorizontalAlignment="Right" Tag="{Binding State.Anc}" IsEnabled="{Binding CanControlAnc}" Click="MiniAnc_Click" ToolTip="{Binding AncHint}" AutomationProperties.Name="{DynamicResource Loc_ToggleAnc}" AutomationProperties.HelpText="{Binding AncHint}"/></Grid>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" ToolTip="{DynamicResource Loc_Volume}"/>
    <Slider x:Name="MiniVolume" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding CanControlVolume}" ToolTip="{Binding VolumeHint}" AutomationProperties.Name="{DynamicResource Loc_BudsVolume}"/>
    <TextBlock Grid.Column="2" Text="{Binding VolumeText}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" MinWidth="32" TextAlignment="Right"/>
   </Grid>
   <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Assertive"/>
   <Grid Margin="0,14,0,0"><TextBlock FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" ToolTip="{Binding Status}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{DynamicResource Loc_Disconnected}"/><Style.Triggers><DataTrigger Binding="{Binding State.Connected}" Value="True"><Setter Property="Text" Value="{DynamicResource Loc_Connected}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button x:Name="ExpandButton" Content="{DynamicResource Loc_Expand}" HorizontalAlignment="Right" Padding="10,6" FontSize="12" Click="Expand_Click" ToolTip="{DynamicResource Loc_ExpandHint}"/></Grid>
  </StackPanel>
 </ScrollViewer>
 </Grid>
</Window>




