<Window Style="{StaticResource AppWindow}" x:Class="BudsConnect.TrayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding TrayTitle}" Width="308" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="22">
 <StackPanel>
  <TextBlock x:Name="DeviceNameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,18"/>
  <UniformGrid Columns="3"><StackPanel><TextBlock Text="{DynamicResource Loc_Left}" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Left}" FontSize="20" Margin="0,3,0,0"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Loc_Right}" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Right}" FontSize="20" Margin="0,3,0,0"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Loc_Case}" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Case}" FontSize="20" Margin="0,3,0,0"/></StackPanel></UniformGrid>
  <Border Background="{DynamicResource Soft}" CornerRadius="9" Padding="4" Margin="0,20,0,0"><UniformGrid Columns="2" IsEnabled="{Binding CanControlAnc}"><RadioButton Style="{StaticResource Segment}" GroupName="TrayAnc" Content="{DynamicResource Loc_AncOff}" FontSize="12" IsChecked="{Binding AncOff, Mode=OneWay}" Click="AncOff_Click"/><RadioButton Style="{StaticResource Segment}" GroupName="TrayAnc" Content="{DynamicResource Loc_On}" FontSize="12" IsChecked="{Binding AncOn, Mode=OneWay}" Click="AncOn_Click"/></UniformGrid></Border>
  <TextBlock Text="{Binding AncHint}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
  <Button Content="{DynamicResource Loc_Open}" Margin="0,16,0,0" Click="Open_Click"/>
 </StackPanel>
 </Border>
</Window>


